  },
  {
   "t": "lit",
   "s": "\n",
   "line": 213
  },
  {
   "t": "lit",
   "s": ":::{admonition}",
   "line": 214
  },
  {
   "t": "lit",
   "s": " ",
   "line": 214
  },
  {
   "t": "tr",
   "id": "S0054",
   "kind": "directive_title",
   "s": "**Solution**",
   "line": 214,
   "lines": [
    214
   ]
  },
  {
   "t": "lit",
   "s": "\n",
   "line": 214
  },
  {
   "t": "lit",
   "s": ":class: dropdown solution\n",
   "line": 215
  },
